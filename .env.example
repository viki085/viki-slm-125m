# Viki SLM 125M - credentials template. Copy to .env.local and fill in the values.
# .env.local is git-ignored and must never be committed or shared.

# Modal (https://modal.com -> Settings -> API Tokens): needed for the cloud data and pretraining stages
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Hugging Face (https://huggingface.co/settings/tokens): a token with WRITE role is needed to push the model
HUGGINGFACE_TOKEN=

# Optional: key for a hosted teacher model (not used in the current build)
TEACHER_API_KEY=
